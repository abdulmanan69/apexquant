# ApexQuant v10.0 - copy to .env and fill in. Keys are read from the environment only,
# never written to disk by the app, never logged, never returned by any endpoint.

# The Odds API (free tier): Mode A automated odds. https://the-odds-api.com
ODDS_API_KEY=

# Gemini Flash (free tier): Mode B screenshot OCR. https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq vision: Mode B fallback OCR. https://console.groq.com
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional Google Sheets webhook (Apps Script) that receives every saved audit as JSON.
SHEETS_WEBHOOK_URL=

# Odds API region passed to the provider: eu, uk, us, au
ODDS_REGION=eu

# Paper bankroll and sizing defaults (also editable on the Settings page)
APEX_BANKROLL=1000
APEX_KELLY_FRACTION=0.25
APEX_KELLY_CAP=0.02
APEX_BLEND_SHARP=0.70
